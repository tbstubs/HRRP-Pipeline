# Copy this file to .env and fill in real values. .env is gitignored.
# Never commit credentials. This file exists so a reader knows what to set.

# Account identifier, NOT the account locator. Snowsight shows it under the
# account menu (bottom left) as "Copy account identifier". Format: ORG-ACCOUNT.
SNOWFLAKE_ACCOUNT=ABCDEFG-HI12345

# The username you log into Snowsight with.
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# ACCOUNTADMIN is the default role on a fresh trial account. A production
# deployment would use a narrower role scoped to this database alone.
SNOWFLAKE_ROLE=ACCOUNTADMIN

# These match sql/01_setup.sql. Change them in both places or not at all.
SNOWFLAKE_WAREHOUSE=healthcare_wh
SNOWFLAKE_DATABASE=healthcare_analytics
SNOWFLAKE_SCHEMA=raw
